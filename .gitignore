# MIMIC is credentialed data: never commit raw or derived patient data
data/raw/
data/interim/
data/processed/
*.csv
*.csv.gz
*.parquet
.env
.venv/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.deepeval/
.DS_Store
results/runs/*
!results/runs/.gitkeep

# aggregate-only summary statistics are safe to track
!results/eda_summary.csv
!docs/case_facts_counts.csv
!docs/rule_eligibility_counts.csv
!docs/case_facts_ai_triage_counts.csv
!docs/audit_sample_ids_only.csv
!docs/case_facts_validation.csv
!docs/eligibility_review_sheet.csv
!docs/plan_label_sheet_template.csv
!docs/scheduler_run_history.csv

# output of runs on synthetic data
results/synthetic/
results/figures/
results/model_runs/
results/workbook2/

# personal working files (templates, drafts, external clones): never pushed
local/

# Training bundles, target plans and adapters stay outside this checkout.
# These patterns also protect against common accidental copies into the repo.
.venv-train/
results/training/
*.safetensors
adapter_model.bin
training_args.bin

# Google Drive download of MIMIC-IV parts (credentialed data): move it to MIMIC_DIR, never commit
data/*.zip
data/*.gz
data/*.csv-*

# Anything else put in data/ (dataset copies, downloads) stays local: only the README and split IDs are tracked
data/*
!data/README.md
!data/splits/
